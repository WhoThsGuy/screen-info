{
  "name": "screen-info",
  "version": "1.0.0",
  "description": "Single-page site that displays monitor/display information in the browser.",
  "keywords": [
    "screen",
    "display",
    "resolution",
    "device-pixel-ratio",
    "monitor"
  ],
  "license": "MIT",
  "author": "WhoThsGuy (https://github.com/WhoThsGuy)",
  "homepage": "https://mydisplay.info/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WhoThsGuy/screen-info.git"
  },
  "bugs": "https://github.com/WhoThsGuy/screen-info/issues",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,css,html,json,md}": "prettier --write"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.8.4",
    "typescript": "^5.9.0"
  }
}
